<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cc.bronya</groupId>
        <artifactId>bronya-starter</artifactId>
        <version>1.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>bronya-sb-starter-web</artifactId>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 基础库：bronya-admin-base 已折叠进本 starter，其依赖在此统一声明 -->
        <dependency>
            <groupId>cc.bronya</groupId>
            <artifactId>bronya-common</artifactId>
        </dependency>
        <dependency>
            <groupId>cc.bronya</groupId>
            <artifactId>bronya-shared</artifactId>
        </dependency>

        <!-- 监控能力（指标门面 BronyaMetrics/@BizMetric + 链路 @BizTrace/TraceFilter + actuator + prometheus 端点），
             由 ext/bronya-sb-starter-monitor 统一提供（收敛自原 bronya-sb-starter-metrics）。
             actuator / micrometer-registry-prometheus 由 monitor 传递引入，此处不再重复声明。 -->
        <dependency>
            <groupId>cc.bronya</groupId>
            <artifactId>bronya-sb-starter-monitor</artifactId>
        </dependency>

        <!-- 统一缓存抽象（底层脚手架：Redis/Redisson 或 Caffeine，条件化装配，随 web 自动传播到所有 web 应用） -->
        <dependency>
            <groupId>cc.bronya</groupId>
            <artifactId>bronya-sb-starter-cache</artifactId>
        </dependency>

        <!-- Web / MVC / 校验 运行时 —— ★内嵌 Servlet 容器决策点★
             容器在本 starter 单点决定为 Jetty；所有依赖本 starter（或 starter-plus）的应用自动获得 Jetty，
             业务/上游模块不必声明任何容器依赖。

             · 用 spring-boot-starter-webmvc 而非 spring-boot-starter-web：
               Boot 4 起 spring-boot-starter-web 已废弃（官方指向 webmvc），两者内容几乎相同，
               且**都会**传递携带 spring-boot-starter-tomcat。
             · 必须排除 spring-boot-starter-tomcat：Boot 择取内嵌容器的优先级是 Tomcat > Jetty > Undertow，
               Tomcat 一旦在 classpath，下面的 Jetty 会被**静默忽略**（不报错，日志里照旧打 Tomcat 的 banner）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 内嵌 Servlet 容器：Jetty（版本由 spring-boot-dependencies 统一管理）。
             docker 容器场景下比 Tomcat 更省资源：线程池按需回收、无 APR/Jasper 等额外装配。
             spring-boot-starter-jetty 自带 jakarta.servlet-api / websocket-api / jetty-ee11-websocket-*，
             故 WebSocket（含 @ServerEndpoint）与 EL 表达式在 Jetty 下照常可用。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jetty</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>

        <!-- Sa-Token 鉴权 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-core</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-jwt</artifactId>
        </dependency>

        <!-- 缓存 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context-support</artifactId>
        </dependency>

        <!-- 管理 UI：Spring Boot Admin 客户端（依赖 actuator / 端点，均由 bronya-sb-starter-monitor 传递提供） -->
        <dependency>
            <groupId>de.codecentric</groupId>
            <artifactId>spring-boot-admin-starter-client</artifactId>
        </dependency>

        <!-- 状态机 -->
        <dependency>
            <groupId>org.springframework.statemachine</groupId>
            <artifactId>spring-statemachine-starter</artifactId>
        </dependency>

        <!-- SkyWalking 日志集成：%tid (输出 traceId 到日志) + GRPCLogClientAppender (上报日志到 OAP)。
             apm-toolkit-logback-1.x 与本地 agent 9.6.0 版本对齐; 无 agent 时 appender 为空壳 no-op,
             %tid 输出 TID:N/A, 不影响未挂 agent 的应用。 -->
        <dependency>
            <groupId>org.apache.skywalking</groupId>
            <artifactId>apm-toolkit-logback-1.x</artifactId>
        </dependency>

    </dependencies>

</project>
