<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cc.bronya</groupId>
        <artifactId>bronya-starter</artifactId>
        <version>1.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>bronya-spring-boot-starter-user</artifactId>

    <dependencyManagement>
        <dependencies>
            <!-- 托管 sa-token-redis-jackson 的传递依赖（redis-template / jackson 等）版本 -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-bom</artifactId>
                <version>${sa-token.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
        </dependency>
        <!-- Sa-Token Redis 共享会话（跨服务 @SaCheckPermission 必需）。
             sa-token 1.45.0 起原 sa-token-redis 拆分为 sa-token-redis-jackson（底层走 spring-boot-starter-data-redis / lettuce） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 图形滑动验证码 -->
        <dependency>
            <groupId>cloud.tianai.captcha</groupId>
            <artifactId>tianai-captcha</artifactId>
            <version>1.5.3</version>
        </dependency>

        <dependency>
            <groupId>cc.bronya</groupId>
            <artifactId>bronya-spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>cc.bronya</groupId>
            <artifactId>bronya-spring-boot-starter-plus</artifactId>
        </dependency>
        <dependency>
            <groupId>cc.bronya</groupId>
            <artifactId>bronya-spring-boot-starter-media</artifactId>
        </dependency>

    </dependencies>

</project>
