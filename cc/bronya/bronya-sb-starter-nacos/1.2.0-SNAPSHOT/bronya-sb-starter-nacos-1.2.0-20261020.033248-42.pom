<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cc.bronya</groupId>
        <artifactId>bronya-starter</artifactId>
        <version>1.2.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>bronya-sb-starter-nacos</artifactId>
    <name>${project.artifactId}</name>
    <description>Nacos 原生 SDK 集成（平替 spring-cloud-alibaba 的 nacos-discovery / nacos-config）：
        自研 DiscoveryClient + ServiceRegistry + 自动注册（含优雅下线），
        配置侧用 Spring Boot 原生 ConfigData API（spring.config.import: nacos:...）+ 变更监听触发 ContextRefresher 刷新。
        只依赖 nacos-client 与 Spring 契约，不引入任何 com.alibaba.cloud 组件。</description>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- bronya 本体不引入 Spring Cloud（无 BOM import）。本 starter 需要 Spring Cloud 的
             Discovery/注册契约与刷新能力，故在此给出**仅本模块编译用**的版本基线：
             消费方（如 bronya-cloud）导入 spring-cloud-dependencies BOM 时，会按依赖管理就近优先
             覆盖这里的版本，不会与消费方的 Cloud 版本打架。
             取值对齐 Spring Cloud 2025.1.3（spring-cloud-commons/context = 5.0.3）。 -->
        <bronya.spring-cloud-commons.version>5.0.3</bronya.spring-cloud-commons.version>
        <bronya.spring-cloud-context.version>5.0.3</bronya.spring-cloud-context.version>
    </properties>

    <dependencies>
        <!-- ===== 唯一硬依赖：Nacos 原生 SDK（纯 Java，零 Spring 依赖，版本由 bronya-parent 统一管理）===== -->
        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-client</artifactId>
        </dependency>

        <!-- ===== Spring Boot 自动配置 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- ===== WebServerInitializedEvent（自动注册在 Web 服务器就绪后触发）=====
             Boot 4 已把 web-server 拆为独立模块；这里 optional：Web/WebFlux 应用本就自带。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-web-server</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== Spring Cloud 契约：DiscoveryClient / ServiceRegistry / AbstractAutoServiceRegistration =====
             非 optional：服务注册发现是本 starter 的核心职责，「加了 starter 却没有发现能力」是无声的坑。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-commons</artifactId>
            <version>${bronya.spring-cloud-commons.version}</version>
        </dependency>

        <!-- ===== Spring Cloud 刷新能力：RefreshScope / ContextRefresher（配置动态刷新用）=====
             optional：不用配置热刷新（或非 Spring Cloud 环境）时不强制引入。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-context</artifactId>
            <version>${bronya.spring-cloud-context.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- ===== 响应式服务发现（ReactiveDiscoveryClient，WebFlux/网关场景）需要 Reactor =====
             optional：Servlet 应用无需引入；WebFlux 应用本就自带 reactor-core。 -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== 以下均为可选增强 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
