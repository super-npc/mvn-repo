<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cc.bronya</groupId>
    <artifactId>bronya-parent</artifactId>
    <version>1.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <bronya.version>1.2.0-SNAPSHOT</bronya.version>
        <bronya-cloud.version>1.0-SNAPSHOT</bronya-cloud.version>

        <!-- Project Settings -->
        <java.version>25</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.compilerVersion>${java.version}</maven.compiler.compilerVersion>
        <maven.compiler.args>--enable-preview</maven.compiler.args>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <resource.delimiter>@</resource.delimiter>

        <!-- Spring Ecosystem -->
        <spring-boot.version>4.0.7</spring-boot.version>
        <commons-compress.version>1.28.0</commons-compress.version>
        <spring-boot-admin.version>4.0.2</spring-boot-admin.version>
        <spring-modulith.version>2.0.5</spring-modulith.version>
        <spring-ai.version>2.0.0-M4</spring-ai.version>
        <spring-ai-alibaba.version>1.1.0.0</spring-ai-alibaba.version>
        <spring-statemachine.version>4.0.1</spring-statemachine.version>
        <springdoc.version>3.0.3</springdoc.version>

        <!-- Database & ORM -->
        <druid.version>1.2.28</druid.version>
        <mybatis-plus-ext.version>3.5.16-EXT901</mybatis-plus-ext.version>
        <mybatis-flex.version>1.11.5</mybatis-flex.version>
        <jsqlparser.version>4.9</jsqlparser.version>
        <dynamic-datasource.version>4.5.0</dynamic-datasource.version>
        <p6spy.version>3.9.1</p6spy.version>
        <p6spy-spring-boot-starter.version>2.0.0</p6spy-spring-boot-starter.version>
        <binlog4j.version>1.9.1</binlog4j.version>
        <!-- auto-table: 2.6.0 起 MysqlTableMetadataBuilder.build() 会显式调用 getTableSchema(), 当实体未配置 schema 时返回 null, 在 MysqlCompareTableInfo 构造器抛 NPE。
             锁回 2.5.15 可保持默认 schema="" 的旧行为,避免 mpe-ext 升级连带炸到下游. -->
        <auto-table.version>2.5.15</auto-table.version>

        <!-- HTTP / RPC -->
        <okhttp.version>4.12.0</okhttp.version>
        <okio.version>3.17.0</okio.version>
        <retrofit.version>3.1.0-SNAPSHOT</retrofit.version>
        <retrofit2-adapter.version>2.11.0</retrofit2-adapter.version>
        <okhttps.version>4.1.0</okhttps.version>
        <java-websocket.version>1.3.8</java-websocket.version>
        <netty.version>5.0.0.Alpha2</netty.version>

        <!-- Utils -->
        <lombok.version>1.18.44</lombok.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <hutool.version>5.8.44</hutool.version>
        <hutool.v7.version>7.0.0-M5</hutool.v7.version>
        <fastjson.version>2.0.61</fastjson.version> <!-- native 编译有问题,退版本,别升级 -->
        <guava.version>33.5.0-jre</guava.version>
        <vavr.version>2.0.0-SNAPSHOT</vavr.version>
        <beetl.version>3.20.2.RELEASE</beetl.version>
        <jodd.version>6.3.0</jodd.version>
        <jodd-lagarto.version>6.0.6</jodd-lagarto.version>
        <cola.version>5.0.0</cola.version>
        <ttl.version>2.14.5</ttl.version>
        <commonmark.version>0.28.0</commonmark.version>
        <bouncycastle.version>1.80</bouncycastle.version>
        <java-markdown-generator.version>1.3.2</java-markdown-generator.version>
        <atlas-chain.version>0.1.1</atlas-chain.version>
        <datafaker.version>2.5.4</datafaker.version>
        <tika.version>3.1.0</tika.version>
        <tinypinyin.version>2.0.3.RELEASE</tinypinyin.version>
        <metadata-extractor.version>2.19.0</metadata-extractor.version>
        <oshi.version>6.4.1</oshi.version>
        <dnsjava.version>3.6.3</dnsjava.version>
        <mica-auto.version>4.0.1</mica-auto.version>
        <image-combiner.version>2.6.8</image-combiner.version>
        <plantuml.version>1.2025.2</plantuml.version>
        <jsch.version>0.1.55</jsch.version>

        <!-- Security & Auth -->
        <sa-token.version>1.45.0</sa-token.version>
        <jasypt.version>3.0.5</jasypt.version>

        <!-- Cache & MQ -->
        <redisson.version>4.3.0</redisson.version>

        <!-- Monitoring & Ops -->
        <slf4j.version>2.0.16</slf4j.version>
        <prometheus.version>0.16.0</prometheus.version>
        <arthas.version>4.2.2</arthas.version>

        <!-- Workflow / Rules -->
        <easy-rules.version>4.1.0</easy-rules.version>
        <mvel.version>2.5.2.Final</mvel.version>
        <liteflow.version>2.13.1</liteflow.version>
        <togglz.version>4.4.0</togglz.version>

        <!-- API Doc -->
        <swagger.version>2.2.22</swagger.version>
        <knife4j.version>5.2.1</knife4j.version>

        <!-- AI / OCR -->
        <langchain4j.version>1.12.1</langchain4j.version>
        <langchain4j-community.version>1.12.0-beta20-SNAPSHOT</langchain4j-community.version>
        <smartjavaai.version>1.0.15</smartjavaai.version>
        <rapidocr.version>0.0.7</rapidocr.version>

        <!-- WeChat / Telegram -->
        <weixin.version>4.8.2-20260322.214559</weixin.version>
        <telegrambots.version>9.3.0</telegrambots.version>

        <!-- Manifold / Vaadin -->
        <manifold-version>2026.1.2</manifold-version>
        <vaadin.version>24.4.6</vaadin.version>

        <!-- Codegen -->
        <auto-service.version>1.1.1</auto-service.version>
        <javapoet.version>1.13.0</javapoet.version>

        <!-- Test -->
        <testcontainers.version>1.19.7</testcontainers.version>

        <!-- Maven Plugins -->
        <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
        <maven-release-plugin.version>3.3.1</maven-release-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <versions-maven-plugin.version>2.21.0</versions-maven-plugin.version>
        <git-commit-id-plugin.version>9.0.2</git-commit-id-plugin.version>
        <jib.version>3.5.1</jib.version>
        <central-publishing-maven-plugin.version>0.10.0</central-publishing-maven-plugin.version>

        <!-- Sonar -->
        <sonar.inclusions>**/*.java,**/*.xml</sonar.inclusions>
        <sonar.exclusions>node_modules/**/*,.idea/**/*,.vscode/**/*,**/src/main/resources,**/src/test/**</sonar.exclusions>
    </properties>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo1.maven.org/maven2/</url>
        </repository>
        <repository>
            <id>github</id>
            <url>https://raw.githubusercontent.com/super-npc/mvn-repo/main/</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </snapshots>
        </repository>
        <repository>
            <id>spring-snapshots</id>
            <name>Spring Snapshots</name>
            <url>https://repo.spring.io/snapshot</url>
            <releases>
                <enabled>false</enabled>
            </releases>
        </repository>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <name>Central Portal Snapshots</name>
            <id>central-portal-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>clojars</id>
            <url>https://repo.clojars.org</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <!-- provided 作用域：仅编译期可用，不参与打包 -->
            <scope>provided</scope>
