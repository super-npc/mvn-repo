        <sonar.exclusions>node_modules/**/*,.idea/**/*,.vscode/**/*,**/src/main/resources,**/src/test/**</sonar.exclusions>

        <!-- ========== 子仓库统一版本（2026-08-24 收敛自 bronya / bronya-cloud 各子 pom 硬编码） ========== -->
        <annotations.version>24.0.1</annotations.version>
        <hypersistence-utils.version>3.15.2</hypersistence-utils.version>
        <shardingsphere.version>5.4.1</shardingsphere.version>
        <mybatis-spring-boot.version>3.0.5</mybatis-spring-boot.version>
        <nacos.version>2.5.4</nacos.version>
        <!-- javassist：rocketmq -> reflections 传递依赖，原 3.21.0-GA 的 POM 在 Central 已损坏，钉到 3.30.2-GA -->
        <javassist.version>3.30.2-GA</javassist.version>
        <tianai-captcha.version>1.5.3</tianai-captcha.version>
        <sshj.version>0.40.0</sshj.version>
        <jfinal-enjoy.version>5.2.2</jfinal-enjoy.version>
        <pgmq-jdbc-client.version>1.0.0</pgmq-jdbc-client.version>
        <paho-mqttv5.version>1.2.5</paho-mqttv5.version>
        <rocketmq-client.version>5.4.0</rocketmq-client.version>
        <rocketmq-client-apis.version>5.2.0</rocketmq-client-apis.version>
        <!-- Spring Cloud（bronya-cloud 专属 BOM，版本值统一在此定义，BOM import 保留在 bronya-cloud） -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <!-- spring-ai-alibaba-bom(1.1.0.0) 未管理 mcp-registry/mcp-distributed，单独钉版（与 Boot 4.0.x / Spring AI 2.0.0-Mx 配套） -->
        <spring-ai-alibaba-mcp.version>2.0.0-M1.1</spring-ai-alibaba-mcp.version>
        <!-- bronya-generate 仓库产物（bronya-cloud 测试期代码生成依赖） -->
        <bronya-generate.version>1.0-SNAPSHOT</bronya-generate.version>
    </properties>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo1.maven.org/maven2/</url>
            <!-- 关 snapshots：Maven 超级 POM 的 central 本来就是 <enabled>false</enabled>，
                 为了显式写地址而重复声明却不写 <snapshots>，反而翻成默认 true
                 ⇒ 每个 cc.bronya *-SNAPSHOT 解析都白问一次 Central（Central 不提供 snapshot）。
                 补回 false 即回到 Maven 默认语义。 -->
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <!-- ★id 从 github 改成 mvn-repo★：原先 pom 用 id=github、settings.xml 的 github profile 用
                 id=mvn-repo，**两个 id 指同一个仓库**（super-npc/mvn-repo）⇒ 每个制品被多探一次，
                 而且「哪个 id 生效」不可预测。现统一为 mvn-repo，并与 settings 那份保持
                 id/url/开关【逐字一致】，两者合并即恒等。
                 注：settings 里名为 github 的是【profile id】，与仓库 id 是两个命名空间，不冲突。 -->
            <id>mvn-repo</id>
            <url>https://raw.githubusercontent.com/super-npc/mvn-repo/main/</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </snapshots>
        </repository>
        <repository>
            <id>spring-snapshots</id>
            <name>Spring Snapshots</name>
            <url>https://repo.spring.io/snapshot</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <!-- 项目无 Spring 官方 SNAPSHOT 依赖（spring-boot 4.0.7 / spring-ai 2.0.0-M4 均为 release/milestone），
                 显式禁用 snapshots：否则每个 cc.bronya *-SNAPSHOT 依赖解析时都会向 repo.spring.io 请求
                 maven-metadata.xml，网络不通时白等 Connect timed out，拖慢/污染每次构建 -->
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <name>Central Portal Snapshots</name>
            <id>central-portal-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <!-- 项目无第三方 sonatype SNAPSHOT 依赖，显式禁用 snapshots，避免自研 *-SNAPSHOT 解析时多余请求 -->
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
            <!-- 显式禁用 snapshots：本仓无「第三方 *-SNAPSHOT」依赖（所有 SNAPSHOT 版本都是本仓自己的
                 cc.bronya:* 模块），而 jitpack 默认 snapshots enabled ⇒ 每个自研 SNAPSHOT 解析都要向
                 jitpack.io 请求 maven-metadata.xml 白撞一次（实测 404 但耗时 ~1.9s）。
                 ★只关 snapshots，不动 release★：jitpack 正常的 Tag 制品（release）照常解析。 -->
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>clojars</id>
            <url>https://repo.clojars.org</url>
            <!-- 同上：本仓无 clojars 坐标，关掉 snapshots 避免每次解析自研 SNAPSHOT 时白撞（实测 404/~1.6s） -->
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

