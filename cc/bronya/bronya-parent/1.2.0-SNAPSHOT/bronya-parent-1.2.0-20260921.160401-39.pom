        <langchain4j.version>1.12.1</langchain4j.version>
        <langchain4j-community.version>1.12.0-beta20-SNAPSHOT</langchain4j-community.version>
        <smartjavaai.version>1.0.15</smartjavaai.version>
        <rapidocr.version>0.0.7</rapidocr.version>

        <!-- WeChat / Telegram -->
        <!-- WxJava（微信开发 Java SDK）：版本由 wx-java-bom 单点收口（见 dependencyManagement 的 import），
             覆盖 weixin-java-common/miniapp/mp/pay/open/cp/channel/store/aispeech 及全部 wx-java-*-spring-boot-starter。
             子模块（bronya-cloud/modules/bc-wx、furina/furina-project-wx）声明依赖不写 <version>；
             某个模块要偏离统一版本时，只在该模块自己的 dependencyManagement 里单点覆盖坐标版本即可。 -->
