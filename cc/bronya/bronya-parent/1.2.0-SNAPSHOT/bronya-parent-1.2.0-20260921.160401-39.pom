            <!--
                hutool 5 的「模块化制品」必须同版本：全仓已经用 ${hutool.version} 的 hutool-all / hutool-crypto，
                但传递依赖会把其它模块按各自的旧版本带进来（nearest-wins，版本号小的反而可能胜出），
                于是出现「新调用方 + 旧被调方」⇒ 运行期 NoSuchMethodError。已踩过的实例：
                x-file-storage-core:2.3.0 带 hutool-core:5.8.28（该类里 NumberWithFormat 还没有 getNumber()），
                而 sa-token-jwt → hutool-jwt:5.8.36 → hutool-json:5.8.36 会调用 NumberWithFormat.getNumber(),
                结果登录时 JWT 签发直接 NoSuchMethodError。
                ⇒ 统一钉到 ${hutool.version}（**就是最大那个版本**）：版本更旧的一方都在调用方，钉高不会让它们找不到方法。
            -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-crypto</artifactId>
                <version>${hutool.version}</version>
            </dependency>
