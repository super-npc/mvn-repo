<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cc.bronya</groupId>
        <artifactId>bronya-parent</artifactId>
        <version>1.2.0-SNAPSHOT</version>
        <relativePath>../bronya/bronya-parent/pom.xml</relativePath>
    </parent>

    <groupId>cc.bronya.cloud</groupId>
    <artifactId>bronya-cloud</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>bronya-cloud</name>
    <description>基于 bronya 基础库的 Spring Cloud 微服务骨架（网关 + 用户/鉴权 + sys + demo）</description>

    <properties>
        <!-- springdoc 3.0.x 适配 Spring Boot 4 / Spring 7（knife4j-gateway 最高 4.5.0 不兼容 Boot 4，故网关不用 knife4j-gateway） -->
        <springdoc.version>3.0.3</springdoc.version>
        <!-- knife4j Next 纯静态前端 webjar（com.baizhukui 5.x，React 重写 UI；与 starter-swagger/demo-server 同版统一）：
             无 Java 代码，Boot 4/WebFlux 无兼容问题；提供第二套 UI /doc.html，读取 springdoc 的 swagger-config -->
        <knife4j-ui.version>5.2.1</knife4j-ui.version>
        <!-- Jib 构建镜像用（参考 apps/bc-app-fmz）。镜像名 = ${docker.registry}/${project.artifactId}，与 docker/app/docker-compose.yml 对齐 -->
        <docker.registry>registry.us-west-1.aliyuncs.com/since</docker.registry>
        <!-- 运行时用【完整 JDK】镜像（2026-09-22 由 25-jre 改回）：项目内要用 Arthas，而
             attach 形态（as.sh / arthas-boot.jar / 运行时附加到已启动 JVM）依赖 jdk.attach 与工具链，
             JRE 镜像不具备 —— 只有「premain -javaagent 注入」这一种形态在 JRE 下可行。
             顺带容器内 jcmd / jstack / jmap 也可用（原先没有）。代价：镜像约 +260MB（~400MB → ~658MB），
             属已知且接受的取舍，详见 docs/jib-image-optimization.md 顶部的决策更新。
             ⚠️ 不要为省体积改回 25-jre，除非确认不再需要容器内 attach 工具。
             另：openjdk 官方库 17+ 停止维护、25 早期 EA 版 attach 有 bug，故统一用 Adoptium Temurin GA。 -->
        <jib.from.image>eclipse-temurin:25-jdk</jib.from.image>
        <!-- 默认跳过 jib：仅设了 jib.skip=false 的应用模块（gateway / sys / user / cine / harness / pipeline / mini-program / fmz，见 deploy-java.yml ③ 步）会构建镜像。
             examples 下的示例项目不设 jib.skip=false，不构建镜像、不参与生产部署 -->
        <jib.skip>true</jib.skip>
        <!-- 应用主类：由各应用模块覆盖 -->
        <jib.main.class>UNSET</jib.main.class>
        <!-- 责任链框架：分镜版本生成流程编排（见 apps/bc-app-cine/docs/adr/0010）。
             极轻量（4 个类、仅依赖 slf4j-api），无 Spring 集成 ⇒ 装配自己写。
             ⚠️ 框架 pom 硬编码 slf4j-api 1.7.32，与本项目 slf4j 2.x 冲突 ⇒ 下方 DM 里已 exclusion。 -->
        <atlas-chain.version>0.1.1</atlas-chain.version>
    </properties>

    <modules>
        <module>bc-framework</module>
        <module>bc-gateway</module>
        <module>bc-admin-server</module>
        <!-- 业务应用聚合（apps：sys/user/bronya-app-harness） -->
        <module>apps</module>
        <module>modules</module>
        <!-- 示例项目聚合（examples：仅日常验证用，不参与生产 docker 部署） -->
        <module>examples</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>cc.bronya</groupId>
            <artifactId>bronya-generate-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM（bronya-cloud 专属，spring cloud 版本值统一在 bronya-parent properties 定义）
                 注意：这里**不再**导入 spring-cloud-alibaba-dependencies。
                 原因：SCA 最新仅到 2025.1.0.0（对齐 Boot 4.0.x / Cloud 2025.1.0），无法跟上本项目的
                 Boot 4.1.1 / Cloud 2025.1.3 基线；Nacos 能力已由自研 bronya-sb-starter-nacos 平替。
                 详见 bronya/springcloudalibaba平替方案.md。 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== 责任链框架（atlas-chain） ========== -->
            <!-- 分镜版本生成流程编排：把「生成一个分镜版本」拆成有序可观测的步骤，见 apps/bc-app-cine/docs/adr/0010。
                 框架只有 4 个类（HandlerContext / BaseHandler / ChainRegistry / ChainExecutor），仅依赖 slf4j-api；
                 parent 里的 atlas-chain-spring-boot-starter 打包于 Boot 2.2 / Spring 5.2 时代，不使用、不引入。
                 ★必须 exclusion slf4j-api★：框架 pom 硬编码 1.7.32，本项目是 slf4j 2.x（混进 1.x 会导致绑定冲突）。 -->
            <dependency>
                <groupId>io.github.nemoob</groupId>
                <artifactId>atlas-chain-core</artifactId>
                <version>${atlas-chain.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.slf4j</groupId>
                        <artifactId>slf4j-api</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- ========== 基础框架模块 ========== -->
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-spring-boot-starter-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-spring-boot-starter-rpc</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ========== 业务模块 api ========== -->
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-user-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-sys-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-example-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-example-demo2-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-example-demo3-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-harness-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-yolo-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-cine-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-mini-program-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-onnx-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ========== 业务模块 server ========== -->
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-user-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-sys-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-example-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-example-demo2-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-example-demo3-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-harness-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-harness-server-single</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-harness-server-team</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-harness-server-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-harness-plugin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-harness-plugin-video-editor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-harness-plugin-fmz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-yolo-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-cine-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-mini-program-server</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ========== 流水线微服务（apps/bc-app-pipeline）==========
                 独立可部署应用：只保留量化侧（OKX / jin10 / quant 节点与 DAG）。
                 2026-09-16 从 bc-app-harness-server-pipeline（当时是库）整体迁出；
                 2026-10-16 引擎与对外契约下沉 modules（bc-pipeline-api / bc-pipeline-engine）。 -->
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-pipeline-server</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ========== 小红书微服务（apps/bc-app-xhs）==========
                 独立可部署应用：小红书账号（多 MCP）+ 账号↔流水线绑定 + 运营流水线。
                 2026-10-16 从 bc-app-pipeline 彻底剥离（含 10 条 DAG / 节点 / 工具 / 登录接口）。 -->
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-app-xhs</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ========== 流水线契约与引擎（modules，依赖库）========== -->
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-pipeline-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-pipeline-engine</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ========== 通用能力模块（modules，依赖库：被 app 依赖，不单独部署）========== -->
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-wx</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- OKX（欧易）V5 能力库：业务逻辑唯一一份、零 AI 注解。
                 被 bc-app-harness-plugin-fmz（AgentScope @Tool 壳）与
                 bc-app-pipeline-server（Spring AI @Tool 壳）共同依赖。 -->
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-okx</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Agnes 上游私有协议能力库：图像/视频协议调用 + 连接配置 + 模型目录。
                 零 AI 框架、不碰存储；宿主（bc-app-cine / bc-app-mini-program）声明依赖不写 version。 -->
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-agnes</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Polymarket 上游 REST 能力库：宿主 app 声明依赖时不写 version -->
            <dependency>
                <groupId>cc.bronya.cloud</groupId>
                <artifactId>bc-polymarket</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 第三方 SDK（WxJava 等）版本统一收口在 bronya-parent 的 dependencyManagement
                 （含 import 的 wx-java-bom），app / modules 声明依赖时不写 <version>，本文件不重复声明。 -->

            <!-- ========== Nacos MCP 组件版本管理 ==========
                 父 BOM（spring-ai-alibaba-bom 1.1.0.0）未管理 mcp-registry/mcp-distributed，
                 版本由 bronya-parent properties + dependencyManagement 统一钉版
                 （spring-ai-alibaba-mcp.version=2.0.0-M1.1，与 Spring Boot 4.0.x / Spring AI 2.0.0-Mx 配套，
                 为 Maven Central 该组件最新版；文档中的 Loadbalanced* 类在此版本已更名 Distributed*）。
                 使用方（如 demo-server）声明依赖即可，无需重复写 <version>。 -->
            <!-- spring-ai-starter-mcp-server-webmvc 已由 spring-ai-bom 管理，无需在此声明 -->
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!-- 用 Jib 构建/推送生产镜像：mvn -Pjib clean package -DskipTests
             凭据走 `docker login registry.us-west-1.aliyuncs.com` 或 settings.xml <server>，不写进 pom。
             jib 版本由 bronya-parent 的 pluginManagement 统一管理（3.5.1）。 -->
        <profile>
            <id>jib</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.google.cloud.tools</groupId>
                        <artifactId>jib-maven-plugin</artifactId>
                        <configuration>
                            <skip>${jib.skip}</skip>
                            <from>
                                <image>${jib.from.image}</image>
                                <platforms>
                                    <platform>
                                        <architecture>amd64</architecture>
                                        <os>linux</os>
                                    </platform>
                                    <platform>
                                        <architecture>arm64</architecture>
                                        <os>linux</os>
                                    </platform>
                                </platforms>
                            </from>
                            <to>
                                <!-- 镜像名与 docker/app/docker-compose.yml 完全一致 -->
                                <image>${docker.registry}/${project.artifactId}</image>
                                <tags>
                                    <tag>${project.version}</tag>
                                    <tag>latest</tag>
                                </tags>
                            </to>
                            <container>
                                <appRoot>/home</appRoot>
                                <workingDirectory>/home</workingDirectory>
                                <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                                <mainClass>${jib.main.class}</mainClass>
                                <environment>
                                    <TZ>Asia/Shanghai</TZ>
                                </environment>
                                <jvmFlags>
                                    <!-- 只留运行时必需（preview + 反射 opens/exports）；堆/GC/Metaspace/jdwp 统一见
                                         docker/app/docker-compose.yml 的 JVM_BOOT_ARGS，勿在此重复。 -->
                                    <jvmFlag>--enable-preview</jvmFlag>
                                    <jvmFlag>--add-opens=java.base/java.lang=ALL-UNNAMED</jvmFlag>
                                    <jvmFlag>--add-opens=java.base/java.lang.invoke=ALL-UNNAMED</jvmFlag>
                                    <jvmFlag>--add-opens=java.base/java.lang.reflect=ALL-UNNAMED</jvmFlag>
                                    <jvmFlag>--add-opens=java.base/java.util=ALL-UNNAMED</jvmFlag>
                                    <jvmFlag>--add-opens=java.base/java.time=ALL-UNNAMED</jvmFlag>
                                    <jvmFlag>--add-opens=java.base/java.math=ALL-UNNAMED</jvmFlag>
                                    <jvmFlag>--add-opens=java.base/java.io=ALL-UNNAMED</jvmFlag>
                                    <jvmFlag>--add-opens=java.base/sun.reflect.annotation=ALL-UNNAMED</jvmFlag>
                                    <jvmFlag>--add-exports=java.base/jdk.internal.ref=ALL-UNNAMED</jvmFlag>
                                    <jvmFlag>--add-exports=java.base/sun.nio.ch=ALL-UNNAMED</jvmFlag>
                                    <jvmFlag>--add-exports=jdk.unsupported/sun.misc=ALL-UNNAMED</jvmFlag>
                                </jvmFlags>
                            </container>
                            <allowInsecureRegistries>true</allowInsecureRegistries>
                        </configuration>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
