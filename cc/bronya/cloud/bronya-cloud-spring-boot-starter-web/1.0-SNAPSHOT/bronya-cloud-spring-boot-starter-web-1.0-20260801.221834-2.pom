<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cc.bronya.cloud</groupId>
        <artifactId>bronya-cloud-framework</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bronya-cloud-spring-boot-starter-web</artifactId>
    <name>${project.artifactId}</name>
    <description>Web 自动配置：统一响应、全局异常、CORS、文档(swagger starter)</description>

    <dependencies>
        <dependency>
            <groupId>cc.bronya.cloud</groupId>
            <artifactId>bronya-cloud-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 文档（OpenAPI + Knife4j /doc.html）：统一收敛到 bronya 的 swagger starter，开箱即用零配置。
             版本由 bronya-parent 的 dependencyManagement 统一管理（本模块 parent=bronya-parent）。 -->
        <dependency>
            <groupId>cc.bronya</groupId>
            <artifactId>bronya-spring-boot-starter-swagger</artifactId>
        </dependency>
        <!-- 配置项加密：application.yml 中的 ENC(...) 敏感值（DB/Redis 密码等）运行时解密。
             算法与 bronya/olive 的 JasyptUtil 对齐，同一密钥的密文互通 -->
        <dependency>
            <groupId>com.github.ulisesbocchio</groupId>
            <artifactId>jasypt-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
