<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cc.bronya.cloud</groupId>
        <artifactId>bronya-cloud</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>modules</artifactId>
    <packaging>pom</packaging>
    <name>${project.artifactId}</name>
    <description>通用能力模块聚合（依赖库，非可部署应用）：apps 下的业务服务按需依赖，不单独部署</description>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <!-- 流水线对外契约（DAG / 运行 VO + Feign）：2026-10-16 由 apps/bc-app-pipeline 抽到 modules，
             供 bc-pipeline-engine 与所有「跑流水线」的应用共用 -->
        <module>bc-pipeline-api</module>
        <!-- 流水线引擎：DAG 定义/执行 + Spring AI 节点装配 + MCP 基础设施 + 运行记录；
             宿主 = bc-app-pipeline-server（量化）/ bc-app-xhs（小红书），各自只带自己的节点与 DAG -->
        <module>bc-pipeline-engine</module>
        <!-- 微信小程序能力库：卡片记账等业务 app 依赖它即获得「小程序 App 配置 / 用户 / 小程序码」能力 -->
        <module>bc-wx</module>
        <!-- OKX（欧易）V5 能力库：业务逻辑唯一一份、零 AI 注解；
             被 bc-app-harness-plugin-fmz（AgentScope @Tool 壳）与 bc-app-pipeline-server（Spring AI @Tool 壳）复用 -->
        <module>bc-okx</module>
        <!-- Agnes 上游私有协议能力库：图像/视频协议调用 + 连接配置 + 模型目录；零 AI 框架、不碰存储。
             被 bc-app-cine（委托迁移）与 bc-app-mini-program（matting-img）共用 -->
        <module>bc-agnes</module>
        <!-- Polymarket 上游 REST 能力库：CLOB/Gamma/Data 三类 API 的 Retrofit 客户端，统一入口 PolymarketClient。
             零 AI 注解、不碰存储，后续开发时被宿主 app 按需依赖 -->
        <module>bc-polymarket</module>
        <!-- n8n 能力库（MCP 单协议）：全部 workflow 列表 / 运行状态 / 触发执行，
             统一入口 N8nClient；零 AI 注解、不碰存储 -->
        <module>bc-n8n</module>
    </modules>

</project>
